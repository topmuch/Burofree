# ═══════════════════════════════════════════════════════════════════
# BUROFREE - Environment Variables for Coolify
# ═══════════════════════════════════════════════════════════════════
# Copy this file and fill in values in Coolify's Environment tab.
# Generate secrets: openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════════

# ─── REQUIRED (set these in Coolify) ──────────────────────────────
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
DB_PASSWORD=

# ─── Domain ───────────────────────────────────────────────────────
DOMAIN=burofree.your-domain.com

# ─── Google OAuth (optional) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CONFIGURED=false

# ─── Microsoft / Azure AD OAuth (optional) ────────────────────────
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
NEXT_PUBLIC_MICROSOFT_CONFIGURED=false

# ─── AI / Groq (optional - falls back to z-ai-web-dev-sdk) ───────
GROQ_API_KEY=

# ─── Stripe (optional) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
